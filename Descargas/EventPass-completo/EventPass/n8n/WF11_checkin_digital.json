        "jsCode": "const m = $input.first().json;\nconst quien = `operador ${m._operador_id}`;\nconst mensajeEstado = {\n  CANCELADA: 'La inscripción está cancelada: no puede ingresar.',\n  LISTA_ESPERA: 'La inscripción está en lista de espera: todavía no tiene cupo confirmado.',\n};\nconst cuando = m._previo ? String(m._previo.fecha_checkin).slice(0, 16).replace('T', ' ') : '';\nconst casos = {\n  INSCRIPCION_NO_EXISTE: {\n    resultado: 'RECHAZADO', status: 404,\n    mensaje: 'No encontramos esa inscripción.',\n    detalle: `La inscripción ${m.inscripcion_id} no existe`,\n  },\n  EVENTO_NO_EXISTE: {\n    resultado: 'RECHAZADO', status: 404,\n    mensaje: 'No encontramos ese evento.',\n    detalle: `El evento ${m.evento_id} no existe`,\n  },\n  EVENTO_INCORRECTO: {\n    resultado: 'RECHAZADO', status: 409,\n    mensaje: `Esa inscripción es del evento ${m.evento_real}, no del ${m.evento_id}.`,\n    detalle: `La inscripción pertenece a ${m.evento_real} pero se intentó en ${m.evento_id}`,\n  },\n  CHECKIN_DUPLICADO: {\n    resultado: 'DUPLICADO', status: 409,\n    mensaje: cuando ? `El ingreso ya había sido registrado el ${cuando}.` : 'El ingreso ya había sido registrado.',\n    detalle: m._previo ? `Ya existe el check-in ${m._previo.checkin_id}` : 'La inscripción ya figura como ASISTIO',\n  },\n  ESTADO_NO_PERMITIDO: {\n    resultado: 'RECHAZADO', status: 409,\n    mensaje: mensajeEstado[m.estado_actual] || `La inscripción está en estado ${m.estado_actual} y no permite el ingreso.`,\n    detalle: `Estado de la inscripción: ${m.estado_actual}`,\n  },\n};\nconst c = casos[m.motivo] || { resultado: 'RECHAZADO', status: 400, mensaje: 'No se pudo registrar el ingreso.', detalle: 'Motivo desconocido' };\nreturn [{\n  json: {\n    // fila que se guarda en EP11_Checkin / Checkins\n    checkin_id: m.checkin_id,\n    inscripcion_id: m.inscripcion_id,\n    evento_id: m.evento_id,\n    usuario_id: m.usuario_id,\n    fecha_checkin: m.fecha_checkin,\n    resultado: c.resultado,\n    detalle: `${c.detalle} (${quien})`,\n    // lo que se le responde al front (las columnas con _ no se guardan)\n    _status: c.status,\n    _body: {\n      ok: false, resultado: c.resultado, error: m.motivo, mensaje: c.mensaje,\n      checkin_id: m.checkin_id, inscripcion_id: m.inscripcion_id, evento_id: m.evento_id,\n      nombre_acreditacion: m.nombre_acreditacion || '',\n      estado: m.estado_actual || '',\n      fecha_checkin_previo: m._previo ? m._previo.fecha_checkin : '',\n    },\n  },\n}];"
      },
