# URL base de n8n (sin / al final). En local con ngrok es el dominio estatico.
VITE_N8N_URL=https://tu-dominio.ngrok-free.app

# URL del Chat Trigger del WF10 (sale en el nodo "When chat message received")
VITE_N8N_CHAT_URL=https://tu-dominio.ngrok-free.app/webhook/xxxxxxxx/chat

# usuario del bot de telegram, sin @
VITE_TELEGRAM_BOT=nombre_de_tu_bot
