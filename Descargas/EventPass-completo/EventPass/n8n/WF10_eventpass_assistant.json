      {
        "name": "Identificar conversación",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const crypto = require('crypto');\nconst d = $input.first().json;\nconst meta = d.metadata || {};\nconst sessionId = String(d.sessionId || 'sin-sesion');\nreturn [{\n  json: {\n    conversation_id: 'CNV-' + crypto.createHash('sha1').update(sessionId).digest('hex').slice(0, 12).toUpperCase(),\n    visitor_id: String(meta.visitor_id || 'ANONIMO').slice(0, 40),\n    token: String(meta.token || ''),\n    mensaje: String(d.chatInput || '').slice(0, 1000),\n  },\n}];\n"
        },
