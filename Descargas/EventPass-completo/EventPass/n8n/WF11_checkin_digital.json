      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst limpiar = (v) => String(v ?? '').trim().toUpperCase();\n// acepta evento_id (como el resto del proyecto) y los nombres que usa el enunciado\nconst inscripcion = limpiar(b.inscripcion_id ?? b.id_inscripcion);\nconst evento = limpiar(b.evento_id ?? b.id_evento ?? b.id_de_evento);\nconst formato = /^[A-Z0-9_-]{3,40}$/;\nconst faltan = [];\nif (!formato.test(inscripcion)) faltan.push('inscripcion_id');\nif (!formato.test(evento)) faltan.push('evento_id');\nreturn [{\n  json: {\n    token: String(b.token || '').trim(),\n    inscripcion_id: inscripcion,\n    evento_id: evento,\n    valida: faltan.length === 0,\n    faltan,\n  },\n}];"
      },
