      {
        "name": "Cupos libres por evento",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const eventos = $('Eventos publicados').all().map(i => i.json).filter(e => e.evento_id);\nconst ins = ($input.first().json.inscripciones || []).filter(i => i.inscripcion_id);\nconst ahoraMs = Date.now();\nconst salida = [];\nfor (const e of eventos) {\n  const inicio = new Date(`${e.fecha}T${e.hora || '00:00'}:00-05:00`).getTime();\n  if (inicio <= ahoraMs) continue; // si ya empezo no se reasigna\n  const confirmados = ins.filter(i => i.evento_id === e.evento_id && ['CONFIRMADA', 'ASISTIO'].includes(i.estado)).length; // ASISTIO tambien ocupa cupo\n  const libres = Number(e.capacidad) - confirmados;\n  if (libres <= 0) continue;\n  ins.filter(i => i.evento_id === e.evento_id && i.estado === 'LISTA_ESPERA').forEach(i => {\n    salida.push({ json: { ...i, _libres: libres, _evento_nombre: e.nombre, _fecha: e.fecha, _hora: e.hora, _lugar: e.lugar } });\n  });\n}\nreturn salida; // si no hay nada que reasignar el flujo termina aqui\n"
        },
        "id": "7900826e-7e8d-4891-9fed-621f9e821d08",
        "position": [
          1440,
          0
        ]
      },
      {
        "name": "Ordenar por fecha_inscripcion ASC",
        "type": "n8n-nodes-base.sort",
        "typeVersion": 1,
        "parameters": {
          "sortFieldsUi": {
            "sortField": [
              {
                "fieldName": "fecha_inscripcion",
                "order": "ascending"
              }
            ]
          },
          "options": {}
        },
        "id": "a8c5385a-7fc6-47b1-aa9e-62583e8fd4c1",
