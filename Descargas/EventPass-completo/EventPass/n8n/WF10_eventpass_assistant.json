          "jsCode": "const c = $('Contexto para la IA').first().json;\nconst r = $input.first().json;\nconst texto = String(r.output || (r.error\n  ? 'Uy, vecino, en este momento el asistente está con mucha demanda. Intenta de nuevo en un minutico.'\n  : 'Uy, no te entendí bien. ¿Me lo repites?'));\nreturn [{\n  json: {\n    message_id: 'MSG-' + Date.now().toString(36).toUpperCase() + 'A',\n    conversation_id: c.conversation_id, usuario_id: c.usuario_id, visitor_id: c.visitor_id,\n    rol: 'ASSISTANT', mensaje: texto,\n    timestamp: new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00',\n  },\n}];\n"
        },
