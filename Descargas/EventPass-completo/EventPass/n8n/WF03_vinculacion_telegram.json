      {
        "name": "Leer mensaje",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const m = $input.first().json.message || {};\nconst texto = String(m.text || '').trim();\nconst partes = texto.split(/\\s+/);\nlet tipo = 'otro';\nif (/^\\/vincular(@\\w+)?$/i.test(partes[0] || '')) tipo = 'vincular';\nelse if (/^\\/start/i.test(texto)) tipo = 'start';\nreturn [{\n  json: {\n    tipo,\n    codigo: String(partes[1] || '').toUpperCase(),\n    chat_id: String(m.chat ? m.chat.id : ''),\n    telegram_username: (m.from && m.from.username) || '',\n    nombre_telegram: (m.from && m.from.first_name) || '',\n  },\n}];\n"
        },
