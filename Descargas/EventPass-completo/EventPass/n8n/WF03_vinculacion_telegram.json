      {
        "name": "Validar código",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const m = $('Leer mensaje').first().json;\nconst codigos = $('Leer códigos (bot)').all().map(i => i.json).filter(c => c.codigo_id);\nconst ahoraMs = Date.now();\nconst ahora = new Date(ahoraMs - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\nconst malo = (msg, extra = {}) => [{ json: { valido: false, chat_id: m.chat_id, mensaje: msg, marcar_expirado: false, ...extra } }];\n\nif (!m.codigo) return malo('Escribe el código así: <b>/vincular ABC123</b>');\nconst c = codigos.find(x => String(x.codigo).toUpperCase() === m.codigo);\nif (!c) return malo('Ese código no existe. Genera uno nuevo desde tu perfil en EventPass.');\nif (c.estado === 'USADO') return malo('Ese código ya fue usado. Cada código sirve una sola vez.');\nif (c.estado === 'CANCELADO') return malo('Ese código fue reemplazado por uno más nuevo. Usa el último que generaste.');\nif (c.estado === 'EXPIRADO' || new Date(c.expira_en).getTime() < ahoraMs) {\n  return malo('Ese código ya venció (duran 15 minutos). Genera uno nuevo desde tu perfil.', {\n    marcar_expirado: c.estado === 'PENDIENTE', codigo_id: c.codigo_id, estado: 'EXPIRADO',\n  });\n}\n\nconst yaActiva = $('Leer vinculaciones (bot)').all().some(i => i.json.usuario_id === c.usuario_id && i.json.estado === 'ACTIVA');\nif (yaActiva) return malo('Tu cuenta de EventPass ya está vinculada.');\n\nreturn [{ json: { valido: true, chat_id: m.chat_id, codigo_id: c.codigo_id, usuario_id: c.usuario_id, estado: 'USADO', usado_en: ahora } }];\n"
        },
        "id": "f22ae45d-4db2-4a3e-b971-29c7dff2aa68",
