      {
        "name": "Calcular recordatorios",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const eventos = $('Eventos publicados').all().map(i => i.json).filter(e => e.evento_id);\nconst confirmadas = $('Solo confirmadas').all().map(i => i.json).filter(i => i.inscripcion_id);\nconst previos = $('Leer recordatorios').all().map(i => i.json).filter(r => r.recordatorio_id);\nconst claves = new Set(previos.map(r => r.clave_idempotencia));\nconst HORA = 3600 * 1000;\nconst ahoraMs = Date.now();\nconst iso = (ms) => new Date(ms - 5 * HORA).toISOString().slice(0, 19) + '-05:00';\n// dos recordatorios: uno el dia antes y otro 2 horas antes\nconst TIPOS = [{ tipo: 'RECORDATORIO_24H', horas: 24 }, { tipo: 'RECORDATORIO_2H', horas: 2 }];\nconst out = [];\n\nfor (const i of confirmadas) {\n  const e = eventos.find(x => x.evento_id === i.evento_id);\n  if (!e) continue;\n  const inicio = new Date(`${e.fecha}T${e.hora || '00:00'}:00-05:00`).getTime();\n  const falta = inicio - ahoraMs;\n  if (falta <= 0) continue;\n  for (const t of TIPOS) {\n    if (falta > t.horas * HORA) continue; // todavia no toca\n    const clave = `${i.usuario_id}|${i.evento_id}|${t.tipo}`;\n    // si el de 24h nunca salio y ya estamos dentro de las 2h, se omite (no tiene sentido mandar los dos juntos)\n    const omitir = t.tipo === 'RECORDATORIO_24H' && falta <= 2 * HORA;\n    out.push({\n      json: {\n        recordatorio_id: 'REC-' + Date.now().toString(36).toUpperCase() + out.length,\n        usuario_id: i.usuario_id,\n        evento_id: i.evento_id,\n        inscripcion_id: i.inscripcion_id,\n        tipo_recordatorio: t.tipo,\n        fecha_programada: iso(inicio - t.horas * HORA),\n        fecha_envio: '',\n        estado: omitir ? 'OMITIDO' : 'PENDIENTE',\n        clave_idempotencia: clave,\n        ya_enviado: claves.has(clave),\n        _evento: { nombre: e.nombre, fecha: e.fecha, hora: e.hora, lugar: e.lugar },\n      },\n    });\n  }\n}\nreturn out;\n"
        },
        "id": "3fec145d-93f2-464f-a8da-db4378cc7f8c",
