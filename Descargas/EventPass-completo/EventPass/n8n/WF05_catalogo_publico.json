      {
        "name": "Calcular cupos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const p = $('Leer parámetros').first().json;\nconst eventos = $('Solo publicables').all().map(i => i.json).filter(e => e.evento_id);\nconst inscripciones = ($input.first().json.inscripciones || []).filter(i => i.inscripcion_id);\nconst ahoraMs = Date.now();\n\n// cupos = capacidad - inscripciones CONFIRMADAS (no se guarda a mano en ningun lado)\nconst conCupos = eventos.map(e => {\n  const delEvento = inscripciones.filter(i => i.evento_id === e.evento_id);\n  const confirmados = delEvento.filter(i => ['CONFIRMADA', 'ASISTIO'].includes(i.estado)).length; // ASISTIO tambien ocupa cupo\n  const enEspera = delEvento.filter(i => i.estado === 'LISTA_ESPERA').length;\n  const capacidad = Number(e.capacidad) || 0;\n  const inicio = new Date(`${e.fecha}T${e.hora || '00:00'}:00-05:00`).getTime();\n  return {\n    evento_id: e.evento_id, nombre: e.nombre, categoria: e.categoria, descripcion: e.descripcion,\n    fecha: e.fecha, hora: e.hora, lugar: e.lugar, capacidad, imagen_url: e.imagen_url,\n    organizador: e.organizador, estado: e.estado,\n    confirmados, en_espera: enEspera,\n    cupos_disponibles: Math.max(capacidad - confirmados, 0),\n    inscripcion_abierta: e.estado === 'PUBLICADO' && inicio > ahoraMs,\n  };\n});\n\nlet status = 200;\nlet body;\nlet resultado = conCupos;\nif (p.tipo === 'DETALLE') {\n  const ev = conCupos.find(e => e.evento_id === p.evento_id);\n  resultado = ev ? [ev] : [];\n  if (!ev) { status = 404; body = { ok: false, error: 'NO_ENCONTRADO', mensaje: 'No encontramos ese evento.' }; }\n  else body = { ok: true, evento: ev };\n} else {\n  if (p.tipo === 'FILTRO' && p.categoria) resultado = conCupos.filter(e => e.categoria === p.categoria);\n  body = { ok: true, total: resultado.length, eventos: resultado };\n}\nreturn [{ json: { status, body, _count: resultado.length } }];\n"
        },
        "id": "bf1286a3-dae7-412b-8d33-3f6816468010",
        "position": [
          1680,
          0
        ]
