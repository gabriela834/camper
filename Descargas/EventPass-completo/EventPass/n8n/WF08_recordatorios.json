      {
        "name": "Datos notificación",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "return $('¿Se envía?').all().map(it => {\n  const r = it.json;\n  const e = r._evento;\n  const cuando = r.tipo_recordatorio === 'RECORDATORIO_24H' ? 'mañana' : 'en un par de horas';\n  return {\n    json: {\n      usuario_id: r.usuario_id, evento_id: r.evento_id, inscripcion_id: r.inscripcion_id,\n      tipo: r.tipo_recordatorio,\n      titulo: `Recordatorio: ${e.nombre} es ${cuando}`,\n      mensaje: `Te recordamos que \"${e.nombre}\" es ${cuando}: ${e.fecha} a las ${e.hora} en ${e.lugar}. Si ya no puedes ir, cancela desde la página para liberar tu cupo a otra persona.`,\n    },\n  };\n});\n"
