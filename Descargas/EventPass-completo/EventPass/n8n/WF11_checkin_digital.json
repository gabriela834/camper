        "jsCode": "const b = $input.first().json;\nconst ahora = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\nreturn [{\n  json: {\n    ...b,\n    checkin_id: 'CHK-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 4).toUpperCase(),\n    fecha_checkin: ahora,\n  },\n}];"
      },
