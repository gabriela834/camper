      {
        "name": "Generar código",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const crypto = require('crypto');\nconst usuarioId = $('Validar sesión (WF02)').first().json.usuario.usuario_id;\nconst yaVinculado = $('Leer vinculaciones').all().some(i => i.json.usuario_id === usuarioId && i.json.estado === 'ACTIVA');\nif (yaVinculado) {\n  return [{ json: { ok: false, error_status: 409, error_codigo: 'YA_VINCULADO', error_mensaje: 'Tu cuenta ya tiene Telegram vinculado.' } }];\n}\nconst horaCO = (ms) => new Date(ms - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\nconst ahora = Date.now();\nconst MINUTOS = 15;\n// sin 0/O ni 1/I para que no se confundan al escribirlo\nconst letras = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\nlet codigo = '';\nfor (let i = 0; i < 6; i++) codigo += letras[crypto.randomInt(letras.length)];\n\n// los codigos pendientes anteriores del mismo usuario se cancelan\nconst viejos = $('Leer códigos').all().map(i => i.json)\n  .filter(c => c.usuario_id === usuarioId && c.estado === 'PENDIENTE')\n  .map(c => c.codigo_id);\n\nreturn [{\n  json: {\n    ok: true,\n    codigo_id: 'COD-' + ahora.toString(36).toUpperCase(),\n    usuario_id: usuarioId,\n    codigo,\n    creado_en: horaCO(ahora),\n    expira_en: horaCO(ahora + MINUTOS * 60 * 1000),\n    estado: 'PENDIENTE',\n    usado_en: '',\n    _cancelar: viejos,\n  },\n}];\n"
        },
        "id": "eb532637-ccac-48e4-a66b-71378fff398e",
