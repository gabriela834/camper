        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const b = $input.first().json.body || {};\nreturn [{\n  json: {\n    accion: String(b.accion || '').trim().toLowerCase(),\n    email: String(b.email || '').trim().toLowerCase(),\n    password: String(b.password || ''),\n    token: String(b.token || '').trim(),\n  },\n}];\n"
