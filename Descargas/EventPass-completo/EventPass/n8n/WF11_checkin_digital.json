    {
      "parameters": {
        "jsCode": "const d = $('Normalizar solicitud').first().json;\nconst yo = $('Validar sesión (WF02)').first().json.usuario;\n// tolera que alguien haya escrito EXITOSO sin tilde a mano en la hoja\nconst esExitoso = (r) => String(r ?? '').normalize('NFD').replace(/[̀-ͯ]/g, '').toUpperCase() === 'EXITOSO';\n\nconst ins = $('Leer inscripciones').all().map(i => i.json).find(i => i.inscripcion_id === d.inscripcion_id);\nconst ev = $('Leer eventos').all().map(i => i.json).find(e => e.evento_id === d.evento_id);\nconst previo = $('Leer historial de check-in').all().map(i => i.json)\n  .find(c => c.inscripcion_id === d.inscripcion_id && esExitoso(c.resultado));\n\nreturn [{\n  json: {\n    inscripcion_id: d.inscripcion_id,\n    evento_id: d.evento_id,\n    existe_inscripcion: !!ins,\n    existe_evento: !!ev,\n    mismo_evento: !!ins && ins.evento_id === d.evento_id,\n    // repetido = ya hay un check-in ÉXITOSO en EP11 o la inscripción ya figura como ASISTIO\n    ya_checkin: !!previo || (!!ins && ins.estado === 'ASISTIO'),\n    estado_ok: !!ins && ins.estado === 'CONFIRMADA',\n    usuario_id: ins ? ins.usuario_id : '',\n    estado_actual: ins ? ins.estado : '',\n    evento_real: ins ? ins.evento_id : '',\n    nombre_acreditacion: ins ? ins.nombre_acreditacion || '' : '',\n    _evento: ev ? { nombre: ev.nombre, fecha: ev.fecha, hora: ev.hora, lugar: ev.lugar } : null,\n    _previo: previo ? { checkin_id: previo.checkin_id, fecha_checkin: previo.fecha_checkin } : null,\n    _operador_id: yo.usuario_id,\n  },\n}];"
      },
      "id": "43d5b4c5-284b-47a0-a487-7a407bbbb5c4",
