      {
        "name": "Datos conversación existente",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const c = $input.first().json;\nconst ahora = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\n// si se despide se marca CERRADA; si vuelve a escribir se reabre\nconst despedida = /^(chao|ch[aá]o|adi[oó]s|bye|hasta luego|gracias,? chao)\\b/i.test(c.mensaje.trim());\nconst fila = { conversation_id: c.conversation_id, fecha_ultima_interaccion: ahora, estado: despedida ? 'CERRADA' : 'ABIERTA' };\nif (c.usuario_id) fila.usuario_id = c.usuario_id;\nreturn [{ json: fila }];\n"
